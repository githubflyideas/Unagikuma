[
  {
    "name": "ntfy",
    "label": "ntfy",
    "fields": [
      {
        "key": "server",
        "type": "url",
        "default": "https://ntfy.sh"
      },
      {
        "key": "topic",
        "type": "text",
        "required": true
      },
      {
        "key": "token",
        "type": "secret"
      }
    ],
    "method": "POST",
    "url": "{{.server}}/{{pathescape .topic}}",
    "content_type": "text",
    "headers": {
      "Title": "{{.Title}}",
      "Priority": "{{if eq .Priority \"low\"}}default{{else if eq .Kind \"RECOVERY\"}}default{{else}}high{{end}}",
      "Tags": "{{if eq .Kind \"RECOVERY\"}}white_check_mark{{else}}rotating_light{{end}}",
      "Authorization": "{{if .token}}Bearer {{.token}}{{end}}"
    },
    "body": "{{.Body}}",
    "limits": {
      "body_bytes": 4000
    }
  },
  {
    "name": "gotify",
    "label": "Gotify",
    "fields": [
      {
        "key": "server",
        "type": "url",
        "required": true
      },
      {
        "key": "token",
        "type": "secret",
        "required": true
      }
    ],
    "method": "POST",
    "url": "{{.server}}/message?token={{urlquery .token}}",
    "content_type": "json",
    "body": "{\"title\":\"{{.Title}}\",\"message\":\"{{.Body}}\",\"priority\":{{if eq .Priority \"low\"}}4{{else}}8{{end}}}"
  },
  {
    "name": "bark",
    "label": "Bark",
    "fields": [
      {
        "key": "server",
        "type": "url",
        "default": "https://api.day.app"
      },
      {
        "key": "device-key",
        "type": "secret",
        "required": true
      }
    ],
    "method": "POST",
    "url": "{{.server}}/push",
    "content_type": "json",
    "body": "{\"device_key\":\"{{index . \"device-key\"}}\",\"title\":\"{{.Title}}\",\"body\":\"{{.Body}}\",\"group\":\"unagikuma\"}",
    "success": {
      "field": "code",
      "equals": "200"
    },
    "limits": {
      "title": 200,
      "body_bytes": 3000
    }
  },
  {
    "name": "pushover",
    "label": "Pushover",
    "fields": [
      {
        "key": "token",
        "type": "secret",
        "required": true
      },
      {
        "key": "user-key",
        "type": "secret",
        "required": true
      }
    ],
    "method": "POST",
    "url": "https://api.pushover.net/1/messages.json",
    "content_type": "json",
    "body": "{\"token\":\"{{.token}}\",\"user\":\"{{index . \"user-key\"}}\",\"title\":\"{{.Title}}\",\"message\":\"{{.Body}}\",\"priority\":{{if eq .Priority \"low\"}}0{{else}}1{{end}}}",
    "success": {
      "field": "status",
      "equals": "1"
    },
    "limits": {
      "title": 250,
      "body": 1024
    }
  },
  {
    "name": "serverchan",
    "label": "ServerChan (Server 酱)",
    "fields": [
      {
        "key": "sendkey",
        "type": "secret",
        "required": true
      }
    ],
    "method": "POST",
    "url": "https://sctapi.ftqq.com/{{pathescape .sendkey}}.send",
    "content_type": "json",
    "body": "{\"title\":\"{{.Title}}\",\"desp\":\"{{.Body}}\"}",
    "success": {
      "field": "code",
      "equals": "0"
    },
    "limits": {
      "title": 32
    }
  },
  {
    "name": "pushplus",
    "label": "PushPlus",
    "fields": [
      {
        "key": "token",
        "type": "secret",
        "required": true
      }
    ],
    "method": "POST",
    "url": "https://www.pushplus.plus/send",
    "content_type": "json",
    "body": "{\"token\":\"{{.token}}\",\"title\":\"{{.Title}}\",\"content\":\"{{.Body}}\",\"template\":\"txt\"}",
    "success": {
      "field": "code",
      "equals": "200"
    },
    "limits": {
      "title": 100,
      "body": 20000
    }
  },
  {
    "name": "teams",
    "label": "Microsoft Teams (Workflows)",
    "fields": [
      {
        "key": "url",
        "type": "secret",
        "required": true
      }
    ],
    "method": "POST",
    "url": "{{.url}}",
    "content_type": "json",
    "body": "{\"type\":\"message\",\"attachments\":[{\"contentType\":\"application/vnd.microsoft.card.adaptive\",\"content\":{\"type\":\"AdaptiveCard\",\"version\":\"1.4\",\"body\":[{\"type\":\"TextBlock\",\"text\":\"{{.Title}}\",\"weight\":\"bolder\",\"wrap\":true},{\"type\":\"TextBlock\",\"text\":\"{{.Body}}\",\"wrap\":true}]}}]}",
    "limits": {
      "body_bytes": 20000
    }
  },
  {
    "name": "matrix",
    "label": "Matrix",
    "fields": [
      {
        "key": "homeserver",
        "type": "url",
        "required": true
      },
      {
        "key": "token",
        "type": "secret",
        "required": true
      },
      {
        "key": "room",
        "type": "text",
        "required": true
      }
    ],
    "method": "PUT",
    "url": "{{.homeserver}}/_matrix/client/v3/rooms/{{pathescape .room}}/send/m.room.message/{{.DeliveryID}}",
    "content_type": "json",
    "headers": {
      "Authorization": "Bearer {{.token}}"
    },
    "body": "{\"msgtype\":\"m.text\",\"body\":\"{{.Text}}\"}"
  },
  {
    "name": "mattermost",
    "label": "Mattermost",
    "fields": [
      {
        "key": "url",
        "type": "secret",
        "required": true
      }
    ],
    "method": "POST",
    "url": "{{.url}}",
    "content_type": "json",
    "body": "{\"text\":\"{{.Text}}\"}",
    "limits": {
      "text": 16000
    }
  },
  {
    "name": "pagerduty",
    "label": "PagerDuty (Events v2)",
    "fields": [
      {
        "key": "routing-key",
        "type": "secret",
        "required": true
      }
    ],
    "method": "POST",
    "url": "https://events.pagerduty.com/v2/enqueue",
    "content_type": "json",
    "body": "{\"routing_key\":\"{{index . \"routing-key\"}}\",\"event_action\":\"{{if eq .Kind \"RECOVERY\"}}resolve{{else}}trigger{{end}}\",\"dedup_key\":\"unagikuma-{{if .GlobalIncidentID}}{{.GlobalIncidentID}}{{else}}{{.DeliveryID}}{{end}}\",\"payload\":{\"summary\":\"{{.Title}}\",\"source\":\"{{if .Instance}}{{.Instance}}{{else}}unagikuma{{end}}\",\"severity\":\"{{if eq .Priority \"low\"}}warning{{else}}critical{{end}}\",\"custom_details\":{\"body\":\"{{.Body}}\"}}}",
    "limits": {
      "title": 1024
    }
  },
  {
    "name": "opsgenie",
    "label": "Opsgenie",
    "fields": [
      {
        "key": "api-key",
        "type": "secret",
        "required": true
      },
      {
        "key": "region",
        "type": "select",
        "options": [
          "us",
          "eu"
        ],
        "default": "us"
      }
    ],
    "method": "POST",
    "url": "https://api.{{if eq .region \"eu\"}}eu.{{end}}opsgenie.com/v2/alerts{{if eq .Kind \"RECOVERY\"}}/unagikuma-{{.GlobalIncidentID}}/close?identifierType=alias{{end}}",
    "content_type": "json",
    "headers": {
      "Authorization": "GenieKey {{index . \"api-key\"}}"
    },
    "body": "{{if eq .Kind \"RECOVERY\"}}{\"note\":\"{{.Title}}\"}{{else}}{\"message\":\"{{trunc 120 .Title}}\",\"alias\":\"unagikuma-{{if .GlobalIncidentID}}{{.GlobalIncidentID}}{{else}}{{.DeliveryID}}{{end}}\",\"description\":\"{{.Body}}\",\"priority\":\"{{if eq .Priority \"low\"}}P3{{else}}P1{{end}}\"}{{end}}",
    "limits": {
      "body": 15000
    }
  },
  {
    "name": "googlechat",
    "label": "Google Chat",
    "fields": [
      {
        "key": "url",
        "type": "secret",
        "required": true
      }
    ],
    "method": "POST",
    "url": "{{.url}}",
    "content_type": "json",
    "body": "{\"text\":\"{{.Text}}\"}",
    "limits": {
      "text": 4000
    }
  },
  {
    "name": "pushbullet",
    "label": "Pushbullet",
    "fields": [
      {
        "key": "token",
        "type": "secret",
        "required": true
      }
    ],
    "method": "POST",
    "url": "https://api.pushbullet.com/v2/pushes",
    "headers": {
      "Access-Token": "{{.token}}"
    },
    "content_type": "json",
    "body": "{\"type\":\"note\",\"title\":\"{{.Title}}\",\"body\":\"{{.Body}}\"}",
    "limits": {
      "title": 250,
      "body": 8000
    }
  },
  {
    "name": "line",
    "label": "LINE (Messaging API)",
    "fields": [
      {
        "key": "token",
        "type": "secret",
        "required": true
      },
      {
        "key": "to",
        "type": "text",
        "required": true,
        "placeholder": "U… (user), C… (group) or R… (room) id"
      }
    ],
    "method": "POST",
    "url": "https://api.line.me/v2/bot/message/push",
    "headers": {
      "Authorization": "Bearer {{.token}}"
    },
    "content_type": "json",
    "body": "{\"to\":\"{{.to}}\",\"messages\":[{\"type\":\"text\",\"text\":\"{{.Text}}\"}]}",
    "limits": {
      "text": 5000
    }
  },
  {
    "name": "clicksend",
    "label": "ClickSend SMS",
    "fields": [
      {
        "key": "username",
        "type": "text",
        "required": true
      },
      {
        "key": "api-key",
        "type": "secret",
        "required": true
      },
      {
        "key": "to",
        "type": "text",
        "required": true,
        "placeholder": "+61411111111,+8613800000000"
      },
      {
        "key": "from",
        "type": "text"
      }
    ],
    "method": "POST",
    "url": "https://rest.clicksend.com/v3/sms/send",
    "headers": {
      "Authorization": "Basic {{b64 (print .username \":\" (index . \"api-key\"))}}"
    },
    "content_type": "json",
    "body": "{\"messages\":[{{range $i, $n := split \",\" .to}}{{if $i}},{{end}}{\"source\":\"unagikuma\",\"body\":\"{{$.Title}}\",\"to\":\"{{$n}}\"{{if $.from}},\"from\":\"{{$.from}}\"{{end}}}{{end}}]}",
    "success": {
      "field": "data.messages.0.status",
      "equals": "SUCCESS"
    },
    "limits": {
      "title": 600
    }
  },
  {
    "name": "datadog",
    "label": "Datadog (events)",
    "fields": [
      {
        "key": "api-key",
        "type": "secret",
        "required": true
      },
      {
        "key": "site",
        "type": "select",
        "options": [
          "datadoghq.com",
          "datadoghq.eu",
          "us3.datadoghq.com",
          "us5.datadoghq.com",
          "ap1.datadoghq.com",
          "ddog-gov.com"
        ],
        "default": "datadoghq.com"
      }
    ],
    "method": "POST",
    "url": "https://api.{{.site}}/api/v1/events",
    "headers": {
      "DD-API-KEY": "{{index . \"api-key\"}}"
    },
    "content_type": "json",
    "body": "{\"title\":\"{{.Title}}\",\"text\":\"{{.Body}}\",\"alert_type\":\"{{if eq .Kind \"RECOVERY\"}}success{{else if eq .Priority \"low\"}}warning{{else}}error{{end}}\",\"aggregation_key\":\"unagikuma-{{if .GlobalIncidentID}}{{.GlobalIncidentID}}{{else}}{{.DeliveryID}}{{end}}\",\"source_type_name\":\"unagikuma\"{{if .Monitor}},\"tags\":[\"monitor:{{.Monitor}}\"]{{end}}}",
    "success": {
      "field": "status",
      "equals": "ok"
    },
    "limits": {
      "title": 500,
      "body": 4000
    }
  },
  {
    "name": "apprise",
    "label": "Apprise API",
    "fields": [
      {
        "key": "server",
        "type": "url",
        "required": true,
        "placeholder": "http://apprise.example.com:8000"
      },
      {
        "key": "key",
        "type": "secret",
        "required": true
      },
      {
        "key": "tag",
        "type": "text"
      }
    ],
    "method": "POST",
    "url": "{{.server}}/notify/{{pathescape .key}}",
    "content_type": "json",
    "body": "{\"title\":\"{{.Title}}\",\"body\":\"{{.Body}}\",\"type\":\"{{if eq .Kind \"RECOVERY\"}}success{{else if eq .Priority \"low\"}}warning{{else}}failure{{end}}\"{{if .tag}},\"tag\":\"{{.tag}}\"{{end}}}"
  }
]
