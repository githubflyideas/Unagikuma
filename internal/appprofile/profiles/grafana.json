{
  "id": "grafana", "title": "Grafana", "reader": "metrics", "path": "/metrics", "port": 3000,
  "docs": "https://grafana.com/docs/grafana/latest/setup-grafana/set-up-grafana-monitoring/",
  "needs": "Nothing to enable: Grafana serves /metrics by default. Open it only to the monitoring host; with basic auth on metrics, give the user and password.",
  "verified": "Grafana 11.3.0",
  "primary": "alerts_error",
  "summary": ["alerts_error", "api_500", "db_in_use"],
  "fields": [
    {"key": "alerts_error", "label": "Alert rules in error", "type": "quantity", "metric": "grafana_alerting_alerts", "labels": {"state": "error"}},
    {"key": "alerts_firing", "label": "Alert rules firing", "type": "quantity", "metric": "grafana_alerting_alerts", "labels": {"state": "alerting"}},
    {"key": "alert_rules", "label": "Alert rules loaded", "type": "quantity", "metric": "grafana_alerting_schedule_alert_rules"},
    {"key": "db_in_use", "label": "Database connections in use", "type": "quantity", "metric": "grafana_database_conn_in_use"},
    {"key": "db_open", "label": "Database connections open", "type": "quantity", "metric": "grafana_database_conn_open"},
    {"key": "api_500", "label": "API 500 responses", "type": "counter", "metric": "grafana_api_response_status_total", "labels": {"code": "500"}},
    {"key": "page_500", "label": "Page 500 responses", "type": "counter", "metric": "grafana_page_response_status_total", "labels": {"code": "500"}}
  ]
}
