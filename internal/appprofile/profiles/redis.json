    {"key": "evicted_keys", "label": "Keys evicted", "label_zh": "已被淘汰的键", "type": "counter", "line": "evicted_keys"},
    {"key": "keyspace_hits", "label": "Keyspace hits", "label_zh": "键空间命中", "type": "counter", "line": "keyspace_hits"},
    {"key": "keyspace_misses", "label": "Keyspace misses", "label_zh": "键空间未命中", "type": "counter", "line": "keyspace_misses"},
    {"key": "uptime", "label": "Uptime (s)", "label_zh": "运行时间（秒）", "type": "quantity", "unit": "s", "line": "uptime_in_seconds"},
    {"key": "replicas", "label": "Connected replicas", "label_zh": "已连接的副本", "type": "quantity", "line": "connected_slaves"},
    {"key": "unsaved_changes", "label": "Changes since the last save", "label_zh": "上次保存后的改动数", "type": "quantity", "line": "rdb_changes_since_last_save"}
  ]
}
