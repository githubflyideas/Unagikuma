    {"key": "used_memory", "label": "Memory used (bytes)", "label_zh": "已用内存（字节）", "type": "quantity", "unit": "B", "line": "used_memory"},
    {"key": "used_memory_rss", "label": "Memory resident (bytes)", "label_zh": "常驻内存（字节）", "type": "quantity", "unit": "B", "line": "used_memory_rss"},
    {"key": "mem_fragmentation_ratio", "label": "Memory fragmentation ratio", "label_zh": "内存碎片率", "type": "quantity", "line": "mem_fragmentation_ratio", "optional": true},
    {"key": "ops_per_sec", "label": "Operations per second (instantaneous)", "label_zh": "每秒操作数（瞬时）", "type": "quantity", "line": "instantaneous_ops_per_sec"},
