    {"key": "connections", "label": "Connections received", "label_zh": "已接收的连接数", "type": "counter", "line": "total_connections_received"},
    {"key": "rejected_connections", "label": "Connections rejected", "label_zh": "被拒绝的连接数", "type": "counter", "line": "rejected_connections"},
